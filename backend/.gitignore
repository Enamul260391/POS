# Throwaway SQLite databases created by one-off STEP 2 / STEP 5 permission
# audits. The application targets MySQL in every environment and PHPUnit uses
# an in-memory SQLite database (`:memory:`), so no legitimate runtime artefact
# ever lands here. Scoped to `/storage/` so a real SQLite file kept anywhere
# else in the project stays visible to git.
/storage/*.sqlite
/storage/*.sqlite3
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# One-off development / verification scripts kept at the project root.
# They hardcode local dev connection details and are not part of the app.
/check_mysql.php
/verify_models.php
/verify_relations.php
