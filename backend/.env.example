# ===========================================================================
# Template only. Copy to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env        (or: copy .env.example .env)
#   php artisan key:generate    (produces APP_KEY — keep it secret)
#
# The values below are the LOCAL DEVELOPMENT defaults. For production, see the
# "PRODUCTION VALUES" notes in the DEPLOYMENT.md checklist next to each key.
# ===========================================================================

APP_NAME=POS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# PRODUCTION: APP_ENV=production, APP_DEBUG=false, APP_URL=https://<api-host>
# APP_DEBUG=true in production leaks stack traces, SQL, file paths and
# environment values through Laravel's error responses. It must be false.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# PRODUCTION: keep at 12. Lowering it weakens password hashing.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# PRODUCTION: LOG_STACK=daily rotates the log automatically and bounds disk
# usage. `single` grows storage/logs/laravel.log without limit.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# PRODUCTION: LOG_LEVEL=info. `debug` records a large volume of detail that
# the application does not need to run in production.
LOG_LEVEL=debug
# Only used by the `daily` log channel (see LOG_STACK above).
# LOG_DAILY_DAYS=14

# MySQL — see database/deployment notes in DEPLOYMENT.md.
# The application targets MySQL in every environment; there is no SQLite path.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_database
DB_USERNAME=root
DB_PASSWORD=

# PRODUCTION: use a dedicated, least-privilege MySQL user. Do not run the
# application as `root`, and never commit the real password.

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: leave unset — config/session.php automatically marks cookies
# `secure` whenever APP_ENV=production. Set explicitly only to override that.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The current application dispatches no queued jobs, so no queue worker is
# required (see DEPLOYMENT.md § Queue / scheduler). `sync` is the honest value
# for a deployment with no worker; the database driver is kept available for
# the default Laravel skeleton.
QUEUE_CONNECTION=database

# Cache backs rate limiting (the `api` and `login` limiters) and the
# application cache. `file` or `database` are both sufficient; the `cache`
# table ships with the default migrations, so `database` is safe out of the box.
# PRODUCTION: CACHE_STORE=database (or file on a persistent disk). No Redis
# server is required by the current implementation.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Not used by the current application — no cache, queue, session or broadcast
# driver is pointed at Redis. Listed because Laravel's stock config reads it.
# Do not set up a Redis server for this project as it stands.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The application sends no email. MAIL_MAILER=log keeps mail in the log
# instead of attempting delivery.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# CORS — comma-separated frontend origins allowed to call the API.
#   dev:   CORS_ALLOWED_ORIGINS=http://localhost:3000
#   prod:  CORS_ALLOWED_ORIGINS=https://<your-frontend-host>
#
# PRODUCTION: the exact production frontend origin MUST be listed here. The
# value is validated at boot: "*" is rejected outright because config/cors.php
# enables `supports_credentials`, and browsers refuse a wildcard origin
# combined with credentials. Leaving this at the localhost default simply
# blocks the real frontend — it never opens access.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Reverse proxy (nginx / Apache / load balancer).
#
# Leave UNSET when PHP is reached directly. When the API sits behind a proxy,
# set it to the proxy's address so `$request->ip()` resolves to the real
# client; without this, every user shares a single rate-limit bucket and one
# mistyped password throttles the whole store.
#
#   single proxy:  TRUSTED_PROXIES=127.0.0.1
#   two proxies:   TRUSTED_PROXIES=10.0.0.1,10.0.0.2
#
# Never use "*" unless the app is reachable only through a proxy you control.
# TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Sanctum — bearer-token authentication is what the frontend actually uses.
# SANCTUM_STATEFUL_DOMAINS only matters for Sanctum's SPA *cookie* flow,
# which this application deliberately does not enable. Listed for completeness.
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

VITE_APP_NAME="${APP_NAME}"
