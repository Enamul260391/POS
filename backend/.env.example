# ===========================================================================
# Template only. Copy to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env        (or: copy .env.example .env)
#   php artisan key:generate    (produces APP_KEY — keep it secret)
#
# The values below are the LOCAL DEVELOPMENT defaults. For production, see the
# "PRODUCTION VALUES" notes in the DEPLOYMENT.md checklist next to each key.
# ===========================================================================

APP_NAME=POS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# Port for `php artisan serve` (its default port is read from SERVER_PORT).
# The local default is 8001, not 8000: another project on the developer machine
# owns 8000. Keep frontend/.env.development.local's NEXT_PUBLIC_API_BASE_URL in
# sync with this port.
# PRODUCTION: unset — the app sits behind a real web server, never `artisan serve`.
SERVER_PORT=8001

# PRODUCTION: APP_ENV=production, APP_DEBUG=false, APP_URL=https://<api-host>
# APP_DEBUG=true in production leaks stack traces, SQL, file paths and
# environment values through Laravel's error responses. It must be false.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# PRODUCTION: keep at 12. Lowering it weakens password hashing.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# PRODUCTION: LOG_STACK=daily rotates the log automatically and bounds disk
# usage. `single` grows storage/logs/laravel.log without limit.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# PRODUCTION: LOG_LEVEL=info. `debug` records a large volume of detail that
# the application does not need to run in production.
LOG_LEVEL=debug
# Only used by the `daily` log channel (see LOG_STACK above).
# LOG_DAILY_DAYS=14

# MySQL — see database/deployment notes in DEPLOYMENT.md.
# The application targets MySQL in every environment; there is no SQLite path.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_database
DB_USERNAME=root
DB_PASSWORD=

# PRODUCTION: use a dedicated, least-privilege MySQL user. Do not run the
# application as `root`, and never commit the real password.

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: leave unset — config/session.php automatically marks cookies
# `secure` whenever APP_ENV=production. Set explicitly only to override that.
# SESSION_SECURE_COOKIE=true

# ---------------------------------------------------------------------------
# Broadcasting (Phase RT-1) - Laravel Reverb WebSocket server.
#
# The realtime server runs as its own process:  php artisan reverb:start
# The REST API never depends on it - every broadcast is guarded, so a stopped
# Reverb only costs live updates, never functionality. `BROADCAST_CONNECTION`
# is deliberately NOT `log`: `log` and `null` both no-op channel authorization,
# which would leave private-channel auth silently unenforced.
#
# PRODUCTION: generate real values with `php artisan reverb:install` and never
# commit them. REVERB_APP_SECRET signs private-channel authorisations; leaking
# it would let anyone subscribe to any business' channel.
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local

# The current application dispatches no queued jobs, so no queue worker is
# required (see DEPLOYMENT.md § Queue / scheduler). `sync` is the honest value
# for a deployment with no worker; the database driver is kept available for
# the default Laravel skeleton.
QUEUE_CONNECTION=database

# Cache backs rate limiting (the `api` and `login` limiters) and the
# application cache. `file` or `database` are both sufficient; the `cache`
# table ships with the default migrations, so `database` is safe out of the box.
# PRODUCTION: CACHE_STORE=database (or file on a persistent disk). No Redis
# server is required by the current implementation.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Not used by the current application — no cache, queue, session or broadcast
# driver is pointed at Redis. Listed because Laravel's stock config reads it.
# Do not set up a Redis server for this project as it stands.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The application sends no email. MAIL_MAILER=log keeps mail in the log
# instead of attempting delivery.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# CORS — comma-separated frontend origins allowed to call the API.
#   dev:   CORS_ALLOWED_ORIGINS=http://localhost:3000
#   prod:  CORS_ALLOWED_ORIGINS=https://<your-frontend-host>
#
# IMPORTANT: this lists the FRONTEND's origin, not the API's own. The two are
# deployed separately, so a browser request from the app to this API is always
# cross-origin and must pass a preflight. Putting this API's own URL here is the
# most common cause of a login screen that silently does nothing.
#
# PRODUCTION: the exact production frontend origin MUST be listed here, with no
# trailing slash and no path. The value is validated at boot:
#
#   "*" is rejected outright, because config/cors.php enables
#   supports_credentials and browsers refuse a wildcard origin combined with
#   credentials.
#
#   A list containing only loopback origins (localhost / 127.0.0.1) is ALSO
#   rejected when APP_ENV=production. No real browser ever sends
#   "Origin: http://localhost:3000" to a public site, so such a list blocks
#   every request — including login — while Laravel logs nothing at all.
#
# Leaving this at the localhost default is fail-safe, never fail-open.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Reverse proxy (nginx / Apache / load balancer).
#
# Leave UNSET when PHP is reached directly. When the API sits behind a proxy,
# set it to the proxy's address so `$request->ip()` resolves to the real
# client; without this, every user shares a single rate-limit bucket and one
# mistyped password throttles the whole store.
#
#   single proxy:  TRUSTED_PROXIES=127.0.0.1
#   two proxies:   TRUSTED_PROXIES=10.0.0.1,10.0.0.2
#
# Never use "*" unless the app is reachable only through a proxy you control.
# TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Rate limiting (config/rate-limiting.php) - no Redis required.
#
# API flood guard (`throttle:api` on the whole api group). Counts EVERY request,
# keyed by user id, or by IP for public endpoints such as login.
# PRODUCTION: 120/minute is appropriate. If legitimate till traffic trips it,
# fix the polling client first rather than raising this.
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_DECAY_MINUTES=1

# Failed sign-in lockout (POST /api/v1/auth/login). Only FAILED attempts count
# and a successful sign-in clears the counter, so a cashier who mistypes a few
# times is slowed down but never locked out for typing the right password.
#
# "account" is keyed by e-mail AND IP; "ip" spans every account from that
# address, which is what makes e-mail-rotation guessing runs impractical.
#
# PRODUCTION: do not raise LOGIN_RATE_LIMIT_MAX_ATTEMPTS above 10, and do not
# drop LOGIN_RATE_LIMIT_DECAY_SECONDS below 30. Those two values together are
# the online-guessing defence.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_DECAY_SECONDS=60
LOGIN_IP_RATE_LIMIT_MAX_ATTEMPTS=20
LOGIN_IP_RATE_LIMIT_DECAY_SECONDS=60

# ---------------------------------------------------------------------------
# Sanctum — bearer-token authentication is what the frontend actually uses.
# SANCTUM_STATEFUL_DOMAINS only matters for Sanctum's SPA *cookie* flow,
# which this application deliberately does not enable. Listed for completeness.
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8001

VITE_APP_NAME="${APP_NAME}"
