# ---------------------------------------------------------------------------
# Environment template - copy to `.env.local` and adjust per environment.
#
# Only `NEXT_PUBLIC_*` variables are exposed to the browser. They are inlined
# at build time, so never place secrets in them: whatever is written here is
# visible to every user of the shipped JavaScript bundle.
#
# This file is committed. `.env.development.local` and every other env file is
# ignored by .gitignore and must stay that way.
# ---------------------------------------------------------------------------
# CRITICAL — which file wins (this caused a production outage)
# ---------------------------------------------------------------------------
# Next.js resolves these files in this order, first match wins:
#
#   1. real environment variables (what CI/CD usually sets)
#   2. .env.$NODE_ENV.local      (.env.production.local / .env.development.local)
#   3. .env.local                ← loaded in BOTH dev AND production
#   4. .env.$NODE_ENV            (.env.production)
#   5. .env
#
# `.env.local` is loaded during a production build too, and it outranks
# `.env.production`. A developer-only `.env.local` therefore SILENTLY overrides
# the production API URL: the bundle ships pointing at http://localhost:8000 and
# every browser call fails. This is exactly the failure recorded in
# docs/DEPLOYMENT.md §5.
#
# Rule: never put deployment-specific values in `.env.local`.
#   local dev   → .env.development.local
#   production  → .env.production (or real env vars in CI/CD)
#   shared      → .env
#
# The API base URL in this template is a development placeholder only. It is the
# LAST fallback in the chain above, so it applies solely when no other file
# defines it.
# ---------------------------------------------------------------------------

# Base URL of the Laravel REST API, including the /api/v1 version prefix.
# NEXT_PUBLIC_API_BASE_URL is canonical; NEXT_PUBLIC_API_URL is a legacy alias.
#
# PRODUCTION: set this to the real production API origin, e.g.
#   NEXT_PUBLIC_API_BASE_URL=https://<your-api-host>/api/v1
# It must be an https:// URL. No production URL is hardcoded anywhere in the
# source: this variable is the single place the deployment targets, and the
# value is baked in at `npm run build` time, so changing it requires a rebuild.
#
# The matching backend variable is CORS_ALLOWED_ORIGINS, which must list this
# app's own origin (https://<your-frontend-host>) — not the API's. The two are
# different hosts; getting them backwards blocks the browser at the CORS
# preflight with no error visible in the Laravel log.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# Public application name used for branding and the browser tab title.
NEXT_PUBLIC_APP_NAME=POS

# Timeout (milliseconds) applied to every request of the shared Axios instance.
NEXT_PUBLIC_API_TIMEOUT=30000

# ---------------------------------------------------------------------------
# Realtime (Phase RT-1) — Laravel Reverb.
#
# OPTIONAL. With NEXT_PUBLIC_REVERB_APP_KEY unset, realtime is disabled entirely
# and the application behaves exactly as it did before: REST loads the
# catalogue, CRUD works, the POS works — just without live updates.
#
# The values below must match the backend's REVERB_APP_KEY / REVERB_HOST /
# REVERB_PORT / REVERB_SCHEME. Only the APP KEY is public: it identifies the
# Reverb application to the browser, exactly as a Pusher key does. The app
# SECRET signs channel authorisations server-side and must NEVER be copied here
# — there is deliberately no NEXT_PUBLIC_REVERB_APP_SECRET.
#
# PRODUCTION: point these at the real Reverb host and use https, so the socket
# upgrades to wss. A mixed-content page cannot open a plain ws:// socket.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=127.0.0.1
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
